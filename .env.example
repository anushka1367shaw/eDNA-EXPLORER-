# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Scientific datasets, PostgreSQL & Storage)
# Server-side service role credentials (NEVER expose to browser)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional public Supabase URL/Anon key if using client-side RLS queries directly
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional server-side administrator email override (bootstrapped admin)
ADMIN_EMAIL=""
