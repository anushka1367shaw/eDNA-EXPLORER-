{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Application user profile stored in Firestore without storing passwords.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "institution": {
          "type": "string",
          "maxLength": 200
        },
        "researchInterest": {
          "type": "string",
          "maxLength": 300
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "emailVerified": {
          "type": "boolean"
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "role", "accountStatus", "emailVerified", "createdAt", "lastLogin"]
    },
    "Project": {
      "title": "Project",
      "description": "Research project grouping environmental DNA datasets and analyses.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "biome": {
          "type": "string",
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "projectName", "status", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped notification records for dataset and analysis status.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "enum": ["info", "success", "warning"]
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "Application UI and scientific workflow preferences for a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "emailNotifications": {
          "type": "boolean"
        },
        "analysisAlerts": {
          "type": "boolean"
        },
        "defaultReferenceDb": {
          "type": "string",
          "enum": ["NCBI_NT", "BOLD", "SILVA"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "emailNotifications", "analysisAlerts", "defaultReferenceDb", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrative action log entries.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "actorEmail", "action", "targetId", "details", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted list of administrator UIDs managed manually.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Platform-wide scientific or maintenance announcements managed by administrators.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "active": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "body", "active", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles; PII isolated to owner or verified administrator."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User research projects for organizing eDNA datasets."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications."
    },
    "/userPreferences/{userId}": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "User application and scientific reference preferences."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrative audit logs."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator registry."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Platform announcements managed by administrators."
    }
  }
}
