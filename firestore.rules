rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'anushka1367@gmail.com'
      );
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll([
        'uid', 'fullName', 'email', 'role', 'accountStatus', 'emailVerified', 'createdAt', 'lastLogin'
      ])
      && data.keys().hasOnly([
        'uid', 'fullName', 'email', 'institution', 'researchInterest',
        'role', 'accountStatus', 'emailVerified', 'photoUrl', 'createdAt', 'lastLogin'
      ])
      && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && (!('institution' in data) || (data.institution is string && data.institution.size() <= 200))
      && (!('researchInterest' in data) || (data.researchInterest is string && data.researchInterest.size() <= 300))
      && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
      && data.role in ['user', 'admin']
      && data.accountStatus in ['active', 'suspended']
      && data.emailVerified is bool
      && data.createdAt is timestamp
      && data.lastLogin is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['ownerUid', 'projectName', 'status', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly([
        'ownerUid', 'projectName', 'description', 'biome', 'location', 'status', 'createdAt', 'updatedAt'
      ])
      && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.projectName is string && data.projectName.size() >= 2 && data.projectName.size() <= 150
      && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
      && (!('biome' in data) || (data.biome is string && data.biome.size() <= 100))
      && (!('location' in data) || (data.location is string && data.location.size() <= 200))
      && data.status in ['active', 'archived']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
      && data.keys().hasOnly(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
      && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
      && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
      && data.type in ['info', 'success', 'warning']
      && data.read is bool
      && data.createdAt is timestamp;
    }

    function isValidUserPreference(data) {
      return data.keys().hasAll([
        'uid', 'theme', 'emailNotifications', 'analysisAlerts', 'defaultReferenceDb', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'theme', 'emailNotifications', 'analysisAlerts', 'defaultReferenceDb', 'updatedAt'
      ])
      && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.theme in ['light', 'dark', 'system']
      && data.emailNotifications is bool
      && data.analysisAlerts is bool
      && data.defaultReferenceDb in ['NCBI_NT', 'BOLD', 'SILVA']
      && data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetId', 'details', 'createdAt'])
      && data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetId', 'details', 'createdAt'])
      && data.actorUid is string && data.actorUid.size() > 0 && data.actorUid.size() <= 128 && data.actorUid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254
      && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
      && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
      && data.details is string && data.details.size() <= 1000
      && data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'active', 'createdBy', 'createdAt'])
      && data.keys().hasOnly(['title', 'body', 'active', 'createdBy', 'createdAt'])
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
      && data.body is string && data.body.size() >= 2 && data.body.size() <= 1000
      && data.active is bool
      && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
      && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users (PII isolated strictly to owner or verified admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'user'
        && incoming().accountStatus == 'active'
        && incoming().createdAt == request.time
        && incoming().lastLogin == request.time;
      allow update: if isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().accountStatus == existing().accountStatus
            && incoming().email == existing().email
            && (
              (incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'institution', 'researchInterest', 'photoUrl', 'lastLogin', 'emailVerified'])
                && incoming().lastLogin == request.time)
              || (incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'emailVerified'])
                && incoming().lastLogin == request.time)
            )
          )
        );
      allow delete: if false;
    }

    // 2. Research Projects
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(projectId)
        && isEmailVerified()
        && isValidProject(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isEmailVerified()
        && isValidProject(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && existing().status != 'archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['projectName', 'description', 'biome', 'location', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(projectId) && (isAdmin() || (isEmailVerified() && existing().ownerUid == request.auth.uid));
    }

    // 3. Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(notificationId)
        && isEmailVerified()
        && isValidNotification(incoming())
        && (isAdmin() || incoming().userId == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isEmailVerified()
        && isValidNotification(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          )
        );
      allow delete: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // 4. User Preferences
    match /userPreferences/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPreference(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserPreference(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'theme', 'emailNotifications', 'analysisAlerts', 'defaultReferenceDb', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // 5. Admin Audit Logs (immutable append-only for admins)
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 6. Trusted Admin Registry (read-only from client)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 7. System Announcements
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(announcementId)
        && isAdmin()
        && isValidAnnouncement(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(announcementId)
        && isAdmin()
        && isValidAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'active']);
      allow delete: if isValidId(announcementId) && isAdmin();
    }
  }
}
